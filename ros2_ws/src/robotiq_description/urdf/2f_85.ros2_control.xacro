<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <!-- 
    Robotiq 2F-85 ROS2 Control Configuration for Gazebo Classic
    Compatible with: ROS2 Humble, gazebo_ros2_control, UR5 integration
  -->
  <xacro:macro name="robotiq_gripper_ros2_control" params="prefix">

    <ros2_control name="${prefix}robotiq_gripper" type="system">
      <hardware>
        <!-- ✅ Gazebo Classic plugin, not Ignition -->
        <plugin>gazebo_ros2_control/GazeboSystem</plugin>
      </hardware>

      <!-- ✅ Primary controllable joint -->
      <joint name="${prefix}robotiq_85_left_knuckle_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- ✅ Mimic joints (handled by Gazebo, so they don’t need command interfaces) -->
      <joint name="${prefix}robotiq_85_right_knuckle_joint">
        <param name="mimic">${prefix}robotiq_85_left_knuckle_joint</param>
        <param name="multiplier">-1</param>
      </joint>

      <joint name="${prefix}robotiq_85_left_inner_knuckle_joint">
        <param name="mimic">${prefix}robotiq_85_left_knuckle_joint</param>
        <param name="multiplier">1</param>
      </joint>

      <joint name="${prefix}robotiq_85_right_inner_knuckle_joint">
        <param name="mimic">${prefix}robotiq_85_left_knuckle_joint</param>
        <param name="multiplier">-1</param>
      </joint>

      <joint name="${prefix}robotiq_85_left_finger_tip_joint">
        <param name="mimic">${prefix}robotiq_85_left_knuckle_joint</param>
        <param name="multiplier">-1</param>
      </joint>

      <joint name="${prefix}robotiq_85_right_finger_tip_joint">
        <param name="mimic">${prefix}robotiq_85_left_knuckle_joint</param>
        <param name="multiplier">1</param>
      </joint>

    </ros2_control>
  </xacro:macro>


</robot>
