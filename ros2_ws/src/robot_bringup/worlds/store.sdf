<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="store_world">

    <!-- ✅ Lighting -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- ✅ Ground -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- ✅ Conveyor Belt -->
    <include>
      <name>conveyor_belt</name>
      <pose>0.5 0 0 0 0 0</pose>
      <uri>model://conveyor_belt</uri>
    </include>

    <!-- ✅ Physics tuned for real-time performance -->
    <physics type="ode">
      <max_step_size>0.002</max_step_size>           <!-- 2 ms step (500 Hz sim) -->
      <real_time_update_rate>500</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>

      <ode>
        <solver>
          <type>quick</type>
          <iters>20</iters>           <!-- reduces CPU cost -->
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
        </constraints>
      </ode>
    </physics>

    <!--  Scene optimization -->
    <scene>
      <shadows>false</shadows>
      <ambient>0.4 0.4 0.4 1.0</ambient>
      <background>0.7 0.7 0.7 1.0</background>
    </scene>

    <!-- Plugins (optional) -->
    <!-- e.g. real-time monitor or world control can be added here -->

    <model name='rectangle'>
      <pose>0.0 -0.166851 0.25 0 0 0</pose> 
      <link name='rectangle_link'>
        <inertial>
          <mass>10</mass>
          <inertia>
            <ixx>0.72917</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.72917</iyy>
            <iyz>0</iyz>
            <izz>1.25</izz>
          </inertia>
          <pose>0 0 0 0 0 0</pose>
        </inertial>
    
        <!-- Collision geometry -->
        <collision name='rectangle_collision'>
          <geometry>
            <box>
              <!-- width (x), depth (y), height (z) -->
              <size>1.0 1.0 1.0</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
    
        <!-- Visual geometry -->
        <visual name='rectangle_visual'>
          <geometry>
            <box>
              <size>1.0 1.0 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.0 0.0 0.0 1</ambient>
            <diffuse>0.0 0.0 0.0 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
    
        <pose>0 0 0 0 0 0</pose>
        <enable_wind>false</enable_wind>
      </link>
    
      <static>true</static>
      <self_collide>false</self_collide>
    </model>
    

  </world>
</sdf>


