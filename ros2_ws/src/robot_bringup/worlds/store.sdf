<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="default">
    <!-- A global light source -->
    <include>
      <uri>model://sun</uri>
    </include>
    <!-- A ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>


 <include>
      <name>conveyor_belt</name>
      <pose>0 0 0 0 0 0</pose>
      <uri>model://conveyor_belt</uri>
    </include>


<model name='cylinder'>
  <pose>0.0 -0.166851 0.25 0 0 0</pose> 
  <link name='cylinder_link'>
    <inertial>
      <mass>10</mass>
      <inertia>
        <ixx>0.72917</ixx>
        <ixy>0</ixy>
        <ixz>0</ixz>
        <iyy>0.72917</iyy>
        <iyz>0</iyz>
        <izz>1.25</izz>
      </inertia>
      <pose>0 0 0 0 0 0</pose>
    </inertial>
    <collision name='cylinder_collision'>
      <geometry>
        <cylinder>
          <radius>0.5</radius>
          <length>1.0</length>
        </cylinder>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>1.0</mu2>
          </ode>
        </friction>
        <bounce/>
        <contact/>
      </surface>
    </collision>
    <visual name='cylinder_visual'>
      <geometry>
        <cylinder>
          <radius>0.5</radius>
          <length>1.0</length>
        </cylinder>
      </geometry>
      <material>
        <ambient>0.0 0.0 0.0 1</ambient>
        <diffuse>0.0 0.0 0.0 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
      </material>
    </visual>
    <pose>0 0 0 0 0 0</pose>
    <enable_wind>false</enable_wind>
  </link>
  <static>true</static>
  <self_collide>false</self_collide>
</model>
 </world>
</sdf>
