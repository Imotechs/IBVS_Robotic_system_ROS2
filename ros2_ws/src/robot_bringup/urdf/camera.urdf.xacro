<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="camera">

  <!-- Macro: Small compact side-mounted camera -->
  <xacro:macro name="add_camera" params="parent_link:=wrist_3_link">


    <!-- ===================== -->
    <!-- Camera Body (Rounded Box) -->
    <!-- ===================== -->
    <link name="camera_body_link">
      <visual>
        <!-- Slightly rounded housing -->
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.05 0.03 0.03"/>
        </geometry>
        <material name="DarkGray">
          <color rgba="0.2 0.2 0.2 1"/>
        </material>

      </visual>

      <collision>
        <geometry>
          <box size="0.05 0.03 0.03"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.12"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia
          ixx="1e-4" iyy="1e-4" izz="1e-4"
          ixy="0.0" ixz="0.0" iyz="0.0"/>
      </inertial>
    </link>

    <!-- ===================== -->
    <!-- Lens (small cylinder) -->
    <!-- ===================== -->
    <link name="camera_lens_link">
      <visual>
        <origin xyz="0 0.2 0.01" rpy="0 ${-pi/4} 0"/>
        <geometry>
          <cylinder radius="0.007" length="0.01"/>
        </geometry>
        <material name="LensBlack">
          <color rgba="0.02 0.02 0.02 1"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <cylinder radius="0.007" length="0.01"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.02"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia
          ixx="0.003" iyy="0.003" izz="0.003"
          ixy="0.0" ixz="0.0" iyz="0.0"/>
      </inertial>
    </link>

       
    <!-- ===================== -->
    <!-- Optical frame (REP-103) -->
    <!-- x right, y down, z forward -->
    <!-- ===================== -->
    <link name="camera_optical_frame">
      <inertial>
        <mass value="0.0001"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia
          ixx="1e-6" iyy="1e-6" izz="1e-6"
          ixy="0.0" ixz="0.0" iyz="0.0"/>
      </inertial>
    </link>

    <joint name="camera_optical_joint" type="fixed">
      <parent link="camera_lens_link"/>
      <child link="camera_optical_frame"/>
      <!-- Rotation from URDF link frame (x forward, y left, z up)
           to optical frame (x right, y down, z forward)
           R = Rz(pi/2) * Rx(-pi/2) → rpy = (-pi/2, 0, -pi/2) -->
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <!-- ===================== -->
    <!-- Gazebo Camera Sensor -->
    <!-- ===================== -->
    <gazebo reference="camera_lens_link">
      <sensor name="rgb_camera" type="camera">
        <pose>0 0 0.0 0 0 0</pose>
        <update_rate>30.0</update_rate> <!-- keep 60Hz or 90Hz if stable -->
        <always_on>true</always_on>
        <visualize>true</visualize>
    
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.03</near>
            <far>15.0</far>
          </clip>
        </camera>
    
        <!-- Correct placement for plugin configuration -->
        <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/ur5</namespace>
            <remapping>image_raw:=camera/image_raw</remapping>
          </ros>
          <camera_name>tcp</camera_name>
          <frame_name>camera_lens_link</frame_name>
          <publish_rate>30.0</publish_rate>  <!-- inside plugin -->
          <queue_size>1</queue_size>          <!-- inside plugin -->
        </plugin>
    
      </sensor>
    </gazebo>
    

    <!-- ===================== -->
    <!-- Joints -->
    <!-- ===================== -->

    <!-- Mount bracket to wrist body -->
    <joint name="camera_bracket_joint" type="fixed">
      <parent link="${parent_link}"/>
      <!-- offset to the side and slightly forward -->
      <child link="camera_body_link"/>
      <!-- <origin xyz="0.04 0.07 -0.07" rpy="0 ${-pi/2} 0"/> -->
      <origin xyz="0 -0.04 -0.02" rpy="0 ${-pi/2} 0"/>
    </joint>

 
    <!-- Attach lens to front of camera body -->
    <joint name="camera_lens_joint" type="fixed">
      <parent link="camera_body_link"/>
      <child link="camera_lens_link"/>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
    </joint>

  </xacro:macro>
</robot>
