<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg name)">

  <!-- Macro to add camera to UR5 end-effector -->
  <xacro:macro name="add_camera" params="parent_link">
    <!-- Extension rod link -->
<link name="camera_mount_link">
    <visual name="rod_visual">
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
        <geometry>
        <cylinder radius="0.01" length="0.12"/> 
      </geometry>
      <material name="Grey">
        <color rgba="0.4 0.4 0.4 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.01" length="0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <inertia ixx="0.00001" ixy="0" ixz="0"
               iyy="0.00001" iyz="0"
               izz="0.00001"/>
    </inertial>
  </link>
  
  

    <!-- Camera Link -->
    <link name="camera_link">
      <!-- Camera Body -->
      <visual name="camera_body_visual">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.06 0.04 0.04"/>
        </geometry>
        <material name="DarkGray">
          <color rgba="0.2 0.2 0.2 1"/>
        </material>
      </visual>

      

      <!-- Collision -->
      <collision name="camera_collision">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.06 0.04 0.04"/>
        </geometry>
      </collision>

      <!-- Inertial (approximate) -->
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.2"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
                 iyy="0.0001" iyz="0.0"
                 izz="0.0001"/>
      </inertial>
      
</link>


<!-- In your robot's xacro file -->
<gazebo reference="camera_link">
    <sensor name="camera_sensor" type="camera">
        <pose>0 0 0.03 0 0 0</pose>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>30.0</update_rate>
      <visualize>true</visualize>
      <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/ur5</namespace>
          <remapping>image_raw:=camera/image_raw</remapping>
        </ros>
        <camera_name>camera</camera_name>
        <frame_name>camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>


      
  <!-- Joint between end-effector and rod -->
  <joint name="camera_mount_joint" type="fixed">
    <parent link="${parent_link}"/> 
    <child link="camera_mount_link"/>
    <origin xyz="0 0 0" rpy="0 ${pi} ${pi}"/> 
  </joint>
  
  <!-- Now attach camera to top of rod -->
  <joint name="camera_joint" type="fixed">
    <parent link="camera_mount_link"/>
    <child link="camera_link"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/> 
  </joint>
  
   

  </xacro:macro>

</robot>
