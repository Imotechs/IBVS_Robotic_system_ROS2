<?xml version="1.0" ?>
<sdf version="1.6">

  <model name="box">
    <static>false</static>

    <!-- Include the actual product geometry -->
    <include>
      <uri>model://product</uri>
      <name>product_model</name>
      <pose>0 0 0 0 0 0</pose>
      <scale>2 2 2</scale>
    </include>

    <!-- Optional: add a small offset or unique name per spawn -->
    <!-- Your ROS spawn script can override pose dynamically -->
    
  </model>

</sdf>
