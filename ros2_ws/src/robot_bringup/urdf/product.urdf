<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="product_box">

  <link name="box">

    <visual name="box_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find ur5_robotiq_description)/meshes/products/product1.dae" scale="1 1 1"/>

      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>

    <collision name="box_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find ur5_robotiq_description)/meshes/products/product1.dae" scale="1 1 1"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.008333" ixy="0.0" ixz="0.0"
               iyy="0.008333" iyz="0.0" izz="0.008333"/>
    </inertial>

  </link>

</robot>
