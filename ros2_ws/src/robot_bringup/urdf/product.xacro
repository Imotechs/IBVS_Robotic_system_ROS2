<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="product">
  <xacro:macro name="simple_product" params="prefix:='product_' name:='box'">
    <link name="${prefix}${name}">
      <collision>
        <geometry>
          <box size="0.2 0.2 0.2"/>
        </geometry>
      </collision>
      <visual>
        <geometry>
          <box size="0.2 0.2 0.2"/>
        </geometry>
        <material name="Red">
          <color rgba="1 0 0 1"/>
        </material>
      </visual>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
  </xacro:macro>
</robot>