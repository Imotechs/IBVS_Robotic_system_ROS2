<sdf version="1.4">
  <model name="conveyor">
      <!-- Fixed belt structure -->
      <link name="belt_visual">
          <pose>0 0 0 0 0 0</pose>
          <visual name="visual">
              <geometry>
                  <mesh>
                      <scale>1.5 12 1</scale>
                      <uri>model://conveyor_belt/meshes/conveyor_belt.dae</uri>
                  </mesh>
              </geometry>
          </visual>
          <collision name="collision">
              <geometry>
                  <mesh>
                      <scale>1.5 12 1</scale>
                      <uri>model://conveyor_belt/meshes/conveyor_belt.dae</uri>
                  </mesh>
              </geometry>
          </collision>
          <inertial>
              <mass>2000.0</mass>
              <inertia>
                  <ixx>4000.0</ixx>
                  <ixy>0.0</ixy>
                  <ixz>0.0</ixz>
                  <iyy>4000.0</iyy>
                  <iyz>0.0</iyz>
                  <izz>4000.0</izz>
              </inertia>
          </inertial>
      </link>

      <!-- Moving belt surface -->
      <link name="belt_moving">
          <pose>0 0 0.741 0 0 0.0</pose>
          <inertial>
              <mass>200.0</mass>
              <inertia>
                  <ixx>400.0</ixx>
                  <ixy>0.0</ixy>
                  <ixz>0.0</ixz>
                  <iyy>400.0</iyy>
                  <iyz>0.0</iyz>
                  <izz>400.0</izz>
              </inertia>
          </inertial>
          <collision name="belt_collision">
              <geometry>
                  <box>
                      <size>0.425 12 0.00001</size>
                  </box>
              </geometry>
              <surface>
                  <friction>
                      <ode>
                          <mu>100.0</mu>
                          <mu2>100.0</mu2>
                      </ode>
                      <torsional>
                          <coefficient>1000.0</coefficient>
                          <patch_radius>0.1</patch_radius>
                      </torsional>
                  </friction>
              </surface>
          </collision>
          <visual name="belt_visual">
              <geometry>
                  <box>
                      <size>0.425 0.5 0.001</size>
                  </box>
              </geometry>
          </visual>
      </link>

      <!-- Joint connecting the links directly -->
      <joint name="belt_joint" type="prismatic">
          <parent>belt_visual</parent>
          <child>belt_moving</child>
          <axis>
              <xyz>0 1 0</xyz>
              <limit>
                  <lower>0.0</lower>
                  <upper>0.01</upper>
              </limit>
          </axis>
      </joint>
        
      <joint name="belt_joint" type="prismatic">
        <parent>conveyorbelt_fixed::belt_visual</parent>
        <child>conveyorbelt_moving::belt_moving</child>
        <axis>
            <xyz>0 1 0</xyz>
            <limit>
                <lower>0.0</lower>
                <upper>0.01</upper>
            </limit>
        </axis>
    </joint>

    <plugin name="ros2_conveyorbelt_plugin" filename="libros2_conveyorbelt_plugin.so" >
        <ros>
            <namespace></namespace>
        </ros>
        <max_velocity>1.0</max_velocity>
        <publish_rate>1000</publish_rate>
    </plugin>

      <!-- Track controller plugin
      <plugin name="TrackController" filename="gz::sim::systems::TrackController">
          <link>belt_moving</link>
          <track_orientation>0 0 0</track_orientation>
          <velocity_topic>/model/conveyor_belt/link/belt_moving/track_cmd_vel</velocity_topic>
          <min_velocity>0</min_velocity>
          <max_velocity>2.0</max_velocity>
          <debug>1</debug>
      </plugin> -->
      
  </model>
</sdf>
